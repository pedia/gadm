{{ template "master.tmpl" . }}
{{ template "lib.tmpl" . }}

{{ define "head" }}
    {{ template "form_css" . }}
{{ end }}


{{ define "tail" }}
    {{ if .filter_groups }}
      <div id="filter-groups-data" style="display:none;">{{ marshal .filter_groups|safehtml }}</div>
      <div id="active-filters-data" style="display:none;">{{ marshal .active_filters }}</div>
    {{ end }}
    {{ template "form_js" . }}
    <script src="{{ admin_static_url "admin/js/bs4_modal.js" "1.0.0" }}"></script>
    <script src="{{ admin_static_url "admin/js/bs4_filters.js" "1.0.0" }}"></script>

    {{ if .actions }}
    {{ template "actionlib_script" .| arg "message" (gettext "Please select at least one record.") 
                        | arg "actions" .actions
                        | arg "actions_confirmation" .actions_confirmation | args  }}
    {{ end }}
{{ end }}


{{ define "body" }}

    {{ if .table_prefix_html }}
        <div class="alert alert-info alert-dismissable">
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
            {{ safehtml .table_prefix_html }}
        </div>
    {{ end }}

    {{ block "model_menu_bar" . }}
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a href="{{ get_url ".index" }}" class="nav-link active">{{ gettext "List" }}{{ if .count }} ({{ .count }}){{ end }}</a>
            </li>

        {{ if .can_create }}
            <li class="nav-item">
            {{- if .create_modal -}}
                {{ template "add_modal_button" .
                | arg "url" (get_url ".create_view" .return_url)
                | arg "btn_class" "nav-link"
                | arg "title" (gettext "Create New Record")
                | arg "modal_window_id" "fa_modal_window"
                | arg "content" (gettext "Create") | args}}
            {{ else }}
                <a href="{{ get_url ".create_view" "url" .return_url }}" title="{{ gettext "Create New Record" }}" class="nav-link">{{ gettext "Create" }}</a>
            {{- end -}}
            </li>
        {{ end }}

    {{ end }}

    {{ if .can_export }}
        {{ template "export_options" . | set "btn_class" "dropdown-toggle" | set "request" .request }}
    {{ end }}

    {{ block "model_menu_bar_before_filters" . }}

        {{- if .filters }}
            <li class="nav-item dropdown">
                {{ template "filter_options" . }}
            </li>
        {{ end -}}

        {{ if .can_set_page_size }}
            <li class="nav-item dropdown">
                {{ template "page_size_form" .
                | arg "page_size" .page_size
                | arg "generator" .page_size_url | args}}
            </li>
        {{ end }}

        {{ if .actions }}
            <li class="nav-item dropdown">
                {{ template "actionlib_dropdown" .actions|first }}
            </li>
        {{ end }}

        {{ if .column_searchable_list }}
            <li class="nav-item ml-2">
                {{ template "search_form" . }}
            </li>
        {{ end }}

        {{ block "model_menu_bar_after_filters" . }}
        </ul>
    {{ end }}

    {{ if .filters }}
        {{ template "filter_form" . }}
        <div class="clearfix"></div>
    {{ end }}

    {{ block "model_list_table" . }}
        {{ $g := . }}
        <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover model-list">
            <thead>
                <tr>
                    {{ if .actions }}
                        <th class="list-checkbox-column">
                            <input type="checkbox" name="rowtoggle" class="action-rowtoggle" title="{{ gettext "Select all records" }}" />
                        </th>
                    {{ end -}}

                    {{- if .column_display_actions }}
                        <th class="">&nbsp;</th>
                    {{ end }}
                    
                    {{$cols := .result.Fields }}
                    {{ range $index, $c := $cols }}
                    {{ if $c.Hidden }} {{ continue }} {{ end }}
                        <th class="column-header col-{{$c.DBName}}">
                            {{- if is_sortable $c.DBName -}}
                                {{- if eq $g.sort_column $c.DBName -}}
                                    <a href="{{ sort_url $c.DBName (not $g.sort_desc) }}" title="{{ gettext "Sort by %s" $c.Label }}">
                                        {{ $c.Label }}
                                        {{- if $g.sort_desc -}}
                                            <span class="fa fa-chevron-up glyphicon glyphicon-chevron-up"></span>
                                        {{- else -}}
                                            <span class="fa fa-chevron-down glyphicon glyphicon-chevron-down"></span>
                                        {{- end }}
                                    </a>
                                {{ else }}
                                    <a href="{{ sort_url $c.DBName }}" title="{{ gettext "Sort by %s" $c.Label }}">{{ $c.Label }}</a>
                                {{ end -}}
                            {{ else -}}
                                {{- $c.Label -}}
                            {{- end -}}
                            {{ if column_descriptions $c.DBName }}
                                <a class="fa fa-question-circle glyphicon glyphicon-question-sign"
                                title="{{ column_descriptions $c.DBName }}"
                                href="javascript:void(0)" data-role="tooltip"
                                ></a>
                            {{- end }}
                        </th>
                    {{ end }}
                </tr>
            </thead>
            {{ range $row := .result.Rows }}
            <tr>
                {{ if $g.actions }}
                    <td>
                        <input type="checkbox" name="rowid" class="action-checkbox" value="{{ $row.GetPkValue }}" title="{{ gettext "Select record" }}" />
                    </td>
                {{ end }}
                    {{ if $g.column_display_actions }}
                        <td class="list-buttons-column">
                                {{ range $action := $g.list_row_actions }}
                                    {{/* use set instead arg */}}
                                    {{ template "render_action" .
                                    | arg "action" $action
                                    | arg "row_id" $row.GetPkValue
                                    | arg "row" $row
                                    | arg "return_url" $g.return_url | args }}
                                {{ end }}
                        </td>
                    {{- end -}}

                    {{ range $c := $cols }}
                        {{ if $c.Hidden }} {{ continue }} {{ end }}
                        {{ $f := $row.FieldOf $c }}
                        <td class="col-{{$c.DBName}}">
                        {{- if $f.IsStruct }}
                            <a href="{{get_url ( printf "%s%s" $f.Endpoint ".details_view") "id" $f.GetPkValue }}">{{ $f.Display }}</a>
                        {{ else if $f.IsSlice }}
                            {{- range $f.Slice}}
                            <a href="{{get_url ( printf "%s%s" .Endpoint ".details_view") "id" .GetPkValue }}">{{.Endpoint}}</a>
                            {{- end }}
                        {{ else }}
                            {{- if is_editable $c.DBName }}
                                {{ list_form $f $row }}
                            {{ else }}
                                {{- $f.Display -}}
                            {{ end }}
                        {{ end -}}
                        </td>
                    {{ end }}
            </tr>
            {{ end }}
            {{ if not $g.data }}
            <tr>
                <td colspan="999">
                    <div class="text-center">
                        {{ gettext "There are no items in the table." }}
                    </div>
                </td>
            </tr>
            {{ end }}
        </table>
        </div>

        {{ .result.PagerHtml }}

        {{ block "actions" . }}
            {{/* actions ( .get_url ".action" ) */}}
            {{ template "actionlib_form" .actions|first }}
        {{ end }}

        {{- if or .edit_modal  (or .create_modal .details_modal) -}}
            {{ template "add_modal_window" . }}
        {{- end -}}

    {{ end -}}

{{ end -}}

{{ end -}}
