<!DOCTYPE html>
<html>

<head></head>

<body>
<textarea rows="20" cols="50">
{{if eq (.query.Get "a") "2"}}
flashed: {{get_flashed_messages}}
{{end}}

session: {{.session}}
user: {{.current_user}}

menu is active: {{ .menu.IsActive }}

menu:
{{ .menu.Name }} {{ .menu.LoginRequired }}

{{ range .menu.Children -}}
  {{ .Name }}: {{ .LoginRequired }}
  {{ range .Children -}}
    {{ .Name }}: {{ .LoginRequired }}
  {{ end }}
{{ end }}


{{range $k, $v := .}}{{$k}}: {{$v|typeOf}}
{{end}}

</textarea>

</body>

</html>